# Database (PostgreSQL or SQLite for quick local test without Docker)
DATABASE_URL=sqlite+aiosqlite:///./healthcopilot.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/healthcopilot

# App settings
ENVIRONMENT=development
STORAGE_PATH=./uploads

# Google Gemini API (Recommended for Intelligence)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
USE_GEMINI=true

# Firebase Database / Firestore (Set to true to test with Firebase)
USE_FIREBASE=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=

# Azure OpenAI (alternative / optional)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview
LLM_MODEL=gpt-4o

# Azure AI Document Intelligence (leave blank to use local OCR fallback)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Azure Blob Storage (leave blank to use ./uploads folder)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=medical-documents

# Microsoft Entra ID (leave blank for Guest/Demo mode)
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# Feature flags
USE_AZURE_STORAGE=false
USE_AZURE_DOC_INTELLIGENCE=false
USE_AZURE_OPENAI=false
